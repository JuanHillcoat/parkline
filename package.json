{
  "name": "parkline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --passWithNoTests",
    "test:watch": "vitest --project unit",
    "test:db": "vitest run --project db",
    "db:up": "docker compose up -d --wait postgres",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "install:admin": "node --env-file-if-exists=.env --import ./scripts/register-ts-resolver.mjs --experimental-transform-types scripts/install-admin.ts"
  },
  "dependencies": {
    "next": "16.4.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "10.12.0",
    "eslint-plugin-boundaries": "7.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
