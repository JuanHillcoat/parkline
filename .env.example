# Copy to .env for local development. Dev-only values, no real secrets.
# Owner connection: used by pnpm db:migrate and pnpm db:create-app-login. When unset, DATABASE_URL is used.
MIGRATE_DATABASE_URL=postgres://parkline:parkline_dev@localhost:54329/parkline

# Application connection. For the restricted two-login setup, point it at the login created by
# pnpm db:create-app-login, for example:
# DATABASE_URL=postgres://parkline_login:<APP_DB_PASSWORD>@localhost:54329/parkline
# With a single login (this default) the app runs as the owner and the restriction is not applied.
DATABASE_URL=postgres://parkline:parkline_dev@localhost:54329/parkline

# Login for the application (pnpm db:create-app-login). The password is read from the environment
# only, never a flag, and must have at least 12 characters. Placeholder, replace it with a local dev value.
# APP_DB_USER=parkline_login
# APP_DB_PASSWORD=change-me-local-dev

# Set to true only when the app runs behind a reverse proxy that overwrites X-Forwarded-Host.
# Left false, a client-supplied X-Forwarded-Host is ignored by the CSRF origin check.
# It also enables the per-address sign-in limit, which uses the first X-Forwarded-For value:
# the proxy must overwrite that header too. Left false, only the per-email limit applies.
# TRUST_FORWARDED_HOST=false
